# OpenRouter (обязательно для распознавания)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3-vl-235b-a22b-instruct

# Опционально (рекомендация OpenRouter): публичный URL приложения для заголовка HTTP-Referer
# OPENROUTER_HTTP_REFERER=https://your-app.onrender.com
# OPENROUTER_APP_TITLE=OCR to Doc

# Лимиты и пути
MAX_UPLOAD_MB=25
TMP_ROOT=./tmp
OPENROUTER_TIMEOUT_SEC=300
PANDOC_TIMEOUT_SEC=120

# CORS: через запятую, например http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Деплой: один origin прод-фронта (если отдельный домен)
# CORS_ORIGINS=https://your-domain.com

# Для POST /convert-docx на машине разработчика должен быть установлен pandoc и доступен в PATH.

# Деплой на Render (секреты только в Dashboard Render, не в git): см. DEPLOY_RENDER.md
